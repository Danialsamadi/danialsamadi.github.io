---
import { ClientRouter } from "astro:transitions";
import Background from "@/components/Background.tsx";
import Ext from "@/components/Ext.astro";
import "@fontsource-variable/vazirmatn";
import "@/styles/global.css";
import { languages, dir, type Lang } from "@/i18n/ui";
import { getLangFromUrl, useTranslations, getSite, localize, unlocalize } from "@/i18n/utils";

const { title, description, narrow = false } = Astro.props as {
  title: string;
  description: string;
  narrow?: boolean;
};
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const site = getSite(lang);
const other: Lang = lang === "fa" ? "en" : "fa";
const basePath = unlocalize(Astro.url.pathname.replace(/\/$/, "") || "/");
const path = basePath === "/" ? "/" : basePath;
const cur = (route: string) => (path === route || path.startsWith(route + "/") ? "page" : undefined);
const full = title === t("brand") ? title : `${title} · ${t("brand")}`;
const tabs = site.tabs.map((tab) => ({ ...tab, href: localize(tab.route, lang) }));
---

<html lang={lang} dir={dir(lang)} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t("brand")} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:locale" content={lang === "fa" ? "fa_IR" : "en_US"} />
    <meta property="og:image" content={new URL(lang === "fa" ? "/og-fa.png" : "/og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={lang === "fa" ? "دنی، یه شبکه‌باز که کد می‌نویسه. 0xdanis.com/fa" : "Dani, a networking guy who codes. 0xdanis.com"} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>👻</text></svg>" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(localize(path, "en"), Astro.site)} />
    <link rel="alternate" hreflang="fa" href={new URL(localize(path, "fa"), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(localize(path, "en"), Astro.site)} />
    <script is:inline>
      // Default dark; user choice in localStorage. Re-applied after each client-side navigation.
      (() => {
        const get = () => localStorage.getItem("theme") || "dark";
        const apply = (doc = document) => (doc.documentElement.dataset.theme = get());
        apply();
        if (window.__theme) return;
        window.__theme = true;
        document.addEventListener("astro:before-swap", (e) => apply(e.newDocument));
        document.addEventListener("click", (e) => {
          if (!e.target.closest("[data-theme-toggle]")) return;
          localStorage.setItem("theme", get() === "dark" ? "light" : "dark");
          apply();
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <Background client:load transition:persist dark={site.background.dark as any} light={site.background.light as any} />
    <header class="glass topbar">
      <div class="topbar-in">
        <a href={localize("/", lang)} class="press brand" aria-label={t("nav.home")}>
          <img src="/ghost.gif" alt="" width="28" height="28" class="ghost" /><span>{t("brand")}</span>
        </a>
        <nav aria-label={t("nav.main")} class="tb-tabs">
          {tabs.map((tab) => (
            <a href={tab.href} class="press tab" aria-current={cur(tab.route)}>{tab.label}</a>
          ))}
        </nav>
        <div class="ext-links">
          <a href={localize(path, other)} class="press lang-link" lang={other} hreflang={other}>{languages[other]}</a>
          <button type="button" class="press theme-btn" data-theme-toggle aria-label={t("nav.theme")}>
            <svg class="i-sun" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
            <svg class="i-moon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
          </button>
          <a href={site.links.github} class="press social">GitHub <Ext /></a>
          <a href={site.links.linkedin} class="press social">LinkedIn <Ext /></a>
        </div>
      </div>
    </header>
    <nav aria-label={t("nav.main")} class="bb glass">
      {tabs.map((tab) => (
        <a href={tab.href} class="press bb-item" aria-current={cur(tab.route)}>
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d={tab.iconPath}></path></svg>
          <span>{tab.label}</span>
        </a>
      ))}
    </nav>
    <div class="content">
      <main class:list={{ narrow }}><slot /></main>
      <footer class="foot">{site.pageCopy.footer}</footer>
    </div>
  </body>
</html>
