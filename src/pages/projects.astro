---
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
import Ext from "@/components/Ext.astro";
import site from "@/site.json";
const c = site.pageCopy.projects;
---

<Base title="projects" description="Things Dani built and broke: v2go, cf-knife, iran-internet-monitor and more.">
  <PageHead eyebrow={c.eyebrow} title={c.title} intro={c.intro} />
  <div class="grid projects">
    {site.projects.map((p) => (
      <article class="card project">
        <span class="foot-note">{p.tag}</span>
        <h2 class="title3">{p.name}</h2>
        <p>{p.story}</p>
        {p.url
          ? <a href={p.url} class="press link">{c.urlLabel.replace(" ↗", "")} <Ext /></a>
          : <span class="foot-note soon">{c.noUrlLabel}</span>}
      </article>
    ))}
  </div>
</Base>
