---
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
import Chev from "@/components/Chev.astro";
import site from "@/site.json";
import { getPosts, meta } from "@/lib";
const c = site.pageCopy.blog;
const posts = await getPosts();
---

<Base title="blog" description="What Dani built, what broke, and the numbers. No tutorials.">
  <PageHead eyebrow={c.eyebrow} title={c.title} intro={c.intro} />
  {posts.length > 0 ? (
    <div class="group">
      {posts.map((p) => (
        <a href={`/blog/${p.id}`} class="row post">
          <span class="grow"><b>{p.data.title}</b><small>{meta(p)}</small></span><Chev />
        </a>
      ))}
    </div>
  ) : <p class="foot-note">posts coming soon.</p>}
</Base>
