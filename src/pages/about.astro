---
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
import site from "@/site.json";
const c = site.pageCopy.about;
---

<Base title="about" description="The lore, speedrun edition: Go tools, hostile networks, a diploma, and the AI memory rabbit hole.">
  <PageHead eyebrow={c.eyebrow} title={c.title} intro={c.intro} />
  <div class="group">
    {site.chapters.map((ch) => (
      <div class="chapter">
        <span class="badge" aria-hidden="true">{ch.n}</span>
        <div><h2 class="title3">{ch.t}</h2><p>{ch.b}</p></div>
      </div>
    ))}
  </div>
  <section class="block">
    <h2 class="title">stuff i love</h2>
    <div class="grid loves">
      {site.loves.map((l) => <div class="card loves"><h3>{l.t}</h3><p>{l.b}</p></div>)}
    </div>
  </section>
  <section class="block">
    <h2 class="title">how i work</h2>
    <p style="max-width:34em">{c.howIWork}</p>
  </section>
</Base>
