---
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
import site from "@/site.json";
const c = site.pageCopy.about;
---

<Base title="about" description="The lore, speedrun edition: from C++ as a kid in Iran to networking tools in Canada.">
  <PageHead eyebrow={c.eyebrow} title={c.title} intro={c.intro} />
  <ol class="timeline">
    {site.chapters.map((ch) => (
      <li>
        <span class="tl-when">{ch.when}</span>
        <div class="card"><h2 class="title3">{ch.t}</h2><p>{ch.b}</p></div>
      </li>
    ))}
  </ol>
  <section class="block">
    <h2 class="title">stuff i love</h2>
    <div class="grid loves">
      {site.loves.map((l) => <div class="card loves"><h3>{l.t}</h3><p>{l.b}</p></div>)}
    </div>
  </section>
  <section class="block">
    <h2 class="title">how i work</h2>
    <p style="max-width:34em">{c.howIWork}</p>
  </section>
</Base>
