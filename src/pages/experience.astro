---
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
import site from "@/site.json";
const c = site.pageCopy.experience;
---

<Base title="experience" description="Where the hours went: Mnemosyne, Synapse, open source, and a Computer Programming diploma from Algonquin College.">
  <PageHead eyebrow={c.eyebrow} title={c.title} />
  <ol class="group">
    {site.experience.map((e) => (
      <li class="kv exp">
        <span>{e.when}</span>
        <div><h2>{e.what} <span>· {e.where}</span></h2><p>{e.b}</p></div>
      </li>
    ))}
  </ol>
  <section class="block">
    <h2 class="title">{c.stackTitle}</h2>
    <div class="chips">{site.stack.map((s) => <span>{s}</span>)}</div>
  </section>
</Base>
