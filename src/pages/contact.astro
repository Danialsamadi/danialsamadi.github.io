---
import Base from "@/layouts/Base.astro";
import PageHead from "@/components/PageHead.astro";
import Ext from "@/components/Ext.astro";
import site from "@/site.json";
const c = site.pageCopy.contact;
const { links } = site;
const rows = [
  { k: "Email", v: links.email.replace("mailto:", ""), href: links.email },
  { k: "GitHub", v: "github.com/Danialsamadi", href: links.github },
  { k: "LinkedIn", v: "linkedin.com/in/danialsamadis", href: links.linkedin },
  ...(links.resume ? [{ k: "Resume", v: "PDF", href: links.resume }] : []),
];
---

<Base title="contact" description="Networking tools, weird network bugs, open source, or a talk for your meetup. Dani replies fast.">
  <div class="contact">
    <PageHead eyebrow={c.eyebrow} title={c.title} intro={c.body} />
    <div class="group">
      {rows.map((r) => (
        <a href={r.href} class="row">
          <span class="grow"><b>{r.k}</b><small class="contact-v">{r.v}</small></span><Ext />
        </a>
      ))}
    </div>
  </div>
</Base>
